// Hub owns this database, and it owns only Hub's own data.
//
// Identity is NOT here and never will be. Who someone is - employee or
// student, their unit, job level and roles - is always asked of Central on
// every sign-in and every launch. Central is the source of truth for people;
// this database is the source of truth for the launcher: which apps exist,
// who may see them, and what users have reported or requested.
//
// That split is also why Hub connects to its own Postgres rather than
// Central's: Hub holds an API token scoped to employees:read and
// students:read, so a compromise of Hub cannot reach health records, consent
// files or employee PII. Giving Hub database credentials to Central would
// throw that away.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Short-lived, single-use SSO handoffs. Deployments may keep using the
// in-memory store; this table is used when SSO_CODE_STORE=postgres so codes
// remain redeemable across Hub instances.
model SsoCode {
  code       String   @id
  token      String
  app_id     String
  state      String?
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([expires_at])
  @@map("sso_codes")
}

// Requirement 9: a quick button on app cards so users can tell MAD Labs a
// tool is not loading.
model AppReport {
  id String @id @default(cuid())

  application_id String

  // Email only, never a user id: Hub does not own user records, so there is
  // nothing here to join against. Central resolves the person when needed.
  reporter_email String
  message        String

  status      ReportStatus @default(OPEN)
  resolved_at DateTime?
  resolved_by String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([application_id])
  @@index([status])
  @@index([created_at])
  @@map("app_reports")
}

// Requirement 10: a prompt for users to ask for an app permission they are
// missing. APPROVED rows are Hub-owned per-user grants for that app.
model AccessRequest {
  id String @id @default(cuid())

  application_id String

  requester_email String
  reason          String?

  status     AccessRequestStatus @default(PENDING)
  decided_at DateTime?
  decided_by String?
  decision_note String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // One open request per person per app - a second click should not create
  // a duplicate for MAD Labs to triage.
  @@unique([application_id, requester_email, status])
  @@index([status])
  @@index([created_at])
  @@map("access_requests")
}

// Admin-facing audit trail. This intentionally stores Hub admin actions, not
// Central identity history: the actor snapshot comes from the active session
// and the entity data points back to Hub-owned rows.
model AuditLog {
  id String @id @default(cuid())

  actor_email String
  actor_name  String?

  action      String
  entity_type String
  entity_id   String
  summary     String
  metadata    Json?

  created_at DateTime @default(now())

  @@index([created_at])
  @@index([actor_email])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

// Session bookkeeping only, not identity - bumped on every Hub login so any
// previously-issued session JWT for that person (any other browser/device)
// fails its next verifySession() check. See lib/session.ts.
//
// Keyed by Central's own Employee/Student id, not email: email is an
// editable field in Central (see EmployeeValidation.UPDATE server-side), so
// a row keyed by email would silently orphan itself the moment someone's
// email changes there - the next resolveCentralIdentity() lookup, done by
// the person's *current* email, would return a *different* Central id than
// whatever this row was keyed on, and their old row would linger, unbumped,
// forever matching nothing. `email` stays as a plain column for admin
// lookups/debugging only, never the identity anchor.
model UserSession {
  central_id      String   @id
  email           String
  session_version Int      @default(0)
  updated_at      DateTime @updatedAt

  @@index([email])
  @@map("user_sessions")
}

// The long-lived half of the shared session. One row per token: each refresh issues a new row in the same
// family and marks the old one rotated. Only the hash is kept. A rotated token that comes back after the
// short grace window means a copy was stolen, so the whole family is revoked.
model RefreshToken {
  id                String    @id @default(cuid())
  family_id         String
  token_hash        String    @unique
  central_id        String
  source            String
  // UserSession.session_version when the family started: a newer login elsewhere ends the older family.
  session_version   Int
  family_expires_at DateTime
  rotated_at        DateTime?
  revoked_at        DateTime?
  created_at        DateTime  @default(now())

  @@index([family_id])
  @@index([central_id])
  @@map("refresh_tokens")
}

// The last time a code was traded for each application. Central asks for it to see that an application signs in
// the code and token way.
model SsoExchangeSeen {
  app_id  String   @id
  seen_at DateTime

  @@map("sso_exchange_seen")
}
