{
  "name": "mws-hub-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed:applications": "bun run seed/seed-applications.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.5.0",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prisma": "^7.8.0",
    "typescript": "^5.6.3"
  }
}
