PORT=4001
NODE_ENV=development

FRONTEND_ORIGIN=http://localhost:5175

# Google OAuth client for Hub specifically - do not reuse Daily Check-in's,
# create a new Client ID in Google Cloud Console with this app's redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Popup code-flow exchanges via postMessage - Google's token endpoint expects
# this literal value here, not the app's actual URL (see mws-data-center's
# server/.env for the same setup).
GOOGLE_REDIRECT_URI="postmessage"

ALLOWED_DOMAIN=millennia21.id

# mws-data-center's internal API (bootstrap-hub-api-client.ts issues this token)
CENTRAL_API_BASE_URL=http://localhost:3010/api/internal
CENTRAL_API_TOKEN=

JWT_SECRET=
SESSION_COOKIE_NAME=hub_session

# Token-relay SSO handoff into satellite apps.
# Hub signs relay tokens with this PKCS#8 RSA private key. Satellite apps must
# verify with the matching public key only; never give them the private key.
# Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out hub-sso-private.pem
#   openssl rsa -in hub-sso-private.pem -pubout -out hub-sso-public.pem
HUB_SSO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
HUB_SSO_KEY_ID=mws-hub-sso-2026-01
# Copy this public key into satellite app env/config for RS256 verification.
HUB_SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DAILY_CHECKIN_API_URL=http://localhost:3003
MTSS_API_URL=http://localhost:3004
