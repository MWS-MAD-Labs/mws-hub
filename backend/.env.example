# MWS Hub - Komodo staging stack env
#
# Copy this into the Komodo stack environment / .env for staging, then fill the
# blank secrets there. Do not commit real secrets to this file.

NODE_ENV=production
PORT=4001

# Public URL that serves the frontend. Backend uses this for redirects and CORS.
# Before DNS is ready, use the temporary Komodo URL that opens this stack.
FRONTEND_ORIGIN=

# Google OAuth client for Hub.
# Add the same temporary Komodo URL as an authorised JavaScript origin in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage

ALLOWED_DOMAIN=millennia21.id

CENTRAL_API_BASE_URL=https://db-stg.mws.web.id/api/internal
CENTRAL_API_TOKEN=

JWT_SECRET=

SESSION_COOKIE_NAME=hub_session

HUB_SSO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
HUB_SSO_KEY_ID=mws-hub-sso-stg-2026-08

HUB_SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Satellite app base URLs. Hub appends /auth/sso internally.
DAILY_CHECKIN_API_URL=https://app.millenniaws.sch.id
MTSS_API_URL=https://app.millenniaws.sch.id/mtss

HUB_API_BASE_URL=
SUPPORT_EMAIL=admin@millennia21.id
# Leave empty before DNS is ready so nginx accepts Komodo's temporary host.
# Once staging DNS exists, set this to https://hub-stg.mws.web.id.
HUB_PUBLIC_URL=
