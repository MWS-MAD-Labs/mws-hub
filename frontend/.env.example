# Leave empty. Frontend and backend share one origin - Vite proxies /auth,
# /apps and /.well-known to the backend in dev, nginx does the same in
# production. Set this only if you deliberately run the API elsewhere.
VITE_HUB_API_BASE_URL=

# Same Google OAuth client as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

VITE_SUPPORT_EMAIL=admin@millennia21.id
